# --- Launch/trading bot (python -m trader) ---
# Use a separate bot from BotFather; two processes can't poll the same token.
TRADER_TELEGRAM_TOKEN=
TRADER_BOT_NAME=Launchpad
# Encrypts stored wallet keys. Generate once, back it up, never change it:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WALLET_ENCRYPTION_KEY=
# A paid RPC (Helius, QuickNode, Triton...) is strongly recommended; the public one is rate limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DEFAULT_SLIPPAGE=15
DEFAULT_PRIORITY_FEE=0.0005
# 1 = only users in verified_users.json (paid via bot.py) can use it
TRADER_REQUIRE_VERIFIED=0
